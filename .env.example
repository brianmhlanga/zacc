# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

# Database (MySQL / MariaDB)
DATABASE_URL="mysql://user:password@localhost:3306/zacc"

# Admin session secret for nuxt-auth-utils. Must be at least 32 characters.
NUXT_SESSION_PASSWORD="change-me-to-a-random-string-of-32-plus-chars"

# Public origin, used to build absolute links in emails and PDFs.
NUXT_PUBLIC_SITE_URL="https://zacc.co.zw"

# ---------------------------------------------------------------------------
# Email transport
#
# Configure EITHER Resend (preferred, tried first) OR SMTP. With neither set,
# sendMail() logs a warning and returns { ok: false, skipped: true } instead of
# silently discarding the message.
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@zacc.co.zw"

SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@zacc.co.zw"

# Inboxes that receive notifications from the public forms.
REPORTS_INBOX_EMAIL="reports@zacc.co.zw"
CONTACT_INBOX_EMAIL="info@zacc.co.zw"
CONTACT_COMPLAINTS_EMAIL="complaints@zacc.co.zw"

# ---------------------------------------------------------------------------
# Recruitment module
# ---------------------------------------------------------------------------

# HMAC secret for time-limited signed file URLs (CVs, ID scans, certificates).
# Falls back to NUXT_SESSION_PASSWORD when unset.
NUXT_FILE_SIGNING_SECRET=""

# Notification outbox poller.
# Set OUTBOX_POLL_MS to tune the interval; set RECRUITMENT_OUTBOX_DISABLED=1 to
# stop this instance from sending (e.g. during a maintenance window, or on any
# additional PM2 instance).
OUTBOX_POLL_MS="30000"
RECRUITMENT_OUTBOX_DISABLED=""
